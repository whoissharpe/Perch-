# ---- Supabase ----
# Project settings -> API. The anon key is safe to expose to clients; row
# level security in supabase/migrations is what actually protects the data.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# The mobile app reads the EXPO_PUBLIC_ prefixed copies. Same values.
EXPO_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
EXPO_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Server-only. Never prefix with NEXT_PUBLIC_ or EXPO_PUBLIC_.
# Used by scripts/seed-osm.ts to bulk insert seeded spots past RLS.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ---- Map tiles (web map only) ----
# Any MapLibre-compatible vector style. The default is fine for local dev but
# rate limited — swap before launch.
NEXT_PUBLIC_MAP_STYLE_URL="https://tiles.openfreemap.org/styles/positron"

# ---- Seed target ----
# The one area you are testing. Do not seed the world. See docs/STRATEGY.md.
SEED_CITY_NAME="Lisbon"
SEED_BBOX="38.6913,-9.2300,38.7955,-9.0900"

# ---- Site ----
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
