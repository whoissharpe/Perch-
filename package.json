{
  "name": "perch",
  "private": true,
  "version": "0.1.0",
  "description": "A shared map of good places to stop.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "web": "npm run dev --workspace @perch/web",
    "web:build": "npm run build --workspace @perch/web",
    "mobile": "npm start --workspace @perch/mobile",
    "ios": "npm run ios --workspace @perch/mobile",
    "android": "npm run android --workspace @perch/mobile",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "seed:osm": "tsx scripts/seed-osm.ts",
    "icons": "node scripts/make-icons.mjs",
    "db:push": "supabase db push",
    "mobile:web": "npm run export:web --workspace @perch/mobile"
  },
  "devDependencies": {
    "sharp": "^0.33.5",
    "tsx": "^4.19.2",
    "typescript": "~5.3.3"
  },
  "engines": {
    "node": ">=20"
  }
}
